# Container image
APP_IMAGE=ghcr.io/prgrms-web-devcourse-final-project/dear-api:latest
SPRING_PROFILES_ACTIVE=prod,demo

# Public endpoints
API_DOMAIN=api.dear4u.cloud
ACME_EMAIL=your-email@example.com
FRONTEND_URL=https://dear4u.cloud
CORS_ALLOWED_ORIGINS=https://dear4u.cloud
CORS_CAPSULE_DOMAIN=https://dear4u.cloud/capsules
COOKIE_DOMAIN=dear4u.cloud

# Database
DB_NAME=dear4u
DB_USERNAME=dear4u
DB_PASSWORD=replace-with-a-random-password
DB_ROOT_PASSWORD=replace-with-a-different-random-password
DB_MAX_POOL_SIZE=8
JPA_DDL_AUTO=update

# Redis
REDIS_PASSWORD=replace-with-a-random-password

# Application secrets
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
AES_KEY=replace-with-base64-encoded-32-byte-key
SHA_SALT=replace-with-a-random-salt

# Demo accounts
DEMO_USER_PASSWORD=replace-with-demo-user-password
DEMO_ADMIN_PASSWORD=replace-with-demo-admin-password

# CoolSMS / Solapi
COOLSMS_API_KEY=replace-me
COOLSMS_API_SECRET=replace-me
COOLSMS_FROM_NUMBER=01012345678

# Google OAuth and Drive
GOOGLE_OAUTH_ID=replace-me
GOOGLE_OAUTH_SECRET=replace-me
GOOGLE_OAUTH_REDIRECT=https://api.dear4u.cloud/login/oauth2/code/google
GOOGLE_DRIVE_REDIRECT=https://api.dear4u.cloud/api/v1/backup/google-drive/connect/callback

# OpenAI
OPENAI_API_KEY=replace-me

# Amazon S3
S3_BUCKET_NAME=replace-me
S3_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
